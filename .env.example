# API base URL (no trailing slash). Same Laravel backend as the booking app.
VITE_API_URL=http://localhost:8000/api

# Capacitor iOS/Android (production / non–live-reload): device "localhost" is the phone.
# Use LAN URL + Laravel port, e.g. VITE_API_URL_MOBILE=http://192.168.254.140:8000/api
# In dev with `quasar dev -m capacitor`, the app uses same-origin /api and
# quasar.config devServer.proxy instead (see VITE_DEV_API_PROXY_TARGET).
# VITE_API_URL_MOBILE=

# Where the dev server proxies /api (your machine running Laravel).
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Set to 1 to use VITE_API_URL_MOBILE in dev (cross-origin; only if you need to debug CORS).
# VITE_CAPACITOR_DISABLE_DEV_PROXY=

# Laravel Reverb — REQUIRED for the live queue (must match REVERB_* in backend .env).
# Realtime silently no-ops when the key is unset.
VITE_REVERB_APP_KEY=pbcourtlcldevkey01234
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
# VITE_REVERB_APP_CLUSTER=mt1

# Mobile builds: send this tenant to the backend's DetectTenant middleware.
# VITE_MOBILE_TENANT_DOMAIN=app.picklecourt.ph
