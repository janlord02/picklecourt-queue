# Loaded automatically by `quasar build` (production mode). WITHOUT this file a
# production build inherits .env (localhost:8000 + localhost:8080 Reverb) and
# every request + the websocket break silently in production. Mirrors the
# booking frontend's .env.production.

# Same Laravel backend as the booking app. The booking frontend's prod build
# uses this exact host (no "/api" suffix — the prod web server maps it), so the
# queue app mirrors it. If your prod API is served under /api, change to
# https://api.picklecourt.ph/api to match.
VITE_API_URL=https://api.picklecourt.ph

# ── Laravel Reverb (live queue realtime) ──
# These MUST match the PRODUCTION backend REVERB_* and point at the public wss
# endpoint (TLS on 443). While VITE_REVERB_APP_KEY is blank, realtime safely
# no-ops and the app falls back to polling — so live updates are OFF in prod
# until you fill these in from your production backend .env.
#
# TODO(prod): set to the production REVERB_APP_KEY (NOT the local dev key).
VITE_REVERB_APP_KEY=
# TODO(prod): confirm the public Reverb host (often the app domain or an
# api/ws subdomain fronted by TLS). Best guess below — verify against nginx.
VITE_REVERB_HOST=openplay.picklecourt.ph
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
# VITE_REVERB_APP_CLUSTER=mt1
